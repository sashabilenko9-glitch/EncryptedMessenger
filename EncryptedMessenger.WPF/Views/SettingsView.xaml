<Window x:Class="EncryptedMessenger.WPF.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen – EncryptedMessenger"
        Height="560" Width="440"
        MinHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgMainBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="⚙  Einstellungen"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <!-- PROFIL -->
        <Border Grid.Row="2"
                Background="{StaticResource BgHeaderBrush}"
                CornerRadius="10"
                Padding="16 14">
            <StackPanel>
                <TextBlock Text="PROFIL"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10"/>
                <TextBlock Text="Anzeigename"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0 0 0 5"/>
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 0 0"/>
            </StackPanel>
        </Border>

        <!-- NETZWERK -->
        <Border Grid.Row="4"
                Background="{StaticResource BgHeaderBrush}"
                CornerRadius="10"
                Padding="16 14">
            <StackPanel>
                <TextBlock Text="NETZWERK"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10"/>

                <Grid Margin="0 0 0 12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TCP-Port (Empfang)"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0 0 0 5"/>
                        <TextBox Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="UDP-Discovery-Port"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="0 0 0 5"/>
                        <TextBox Text="{Binding UdpPort, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <!-- Discovery toggle -->
                <Border Background="{StaticResource BgMainBrush}"
                        CornerRadius="8"
                        Padding="12 10">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding EnableDiscovery}"
                                  VerticalAlignment="Center"
                                  Margin="0 0 10 0">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <StackPanel>
                            <TextBlock Text="UDP-Geräteerkennung aktivieren"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"/>
                            <TextBlock Text="Andere Instanzen im WLAN automatisch finden"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       Margin="0 2 0 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- SICHERHEIT (Info) -->
        <Border Grid.Row="6"
                Background="{StaticResource BgHeaderBrush}"
                CornerRadius="10"
                Padding="16 14">
            <StackPanel>
                <TextBlock Text="SICHERHEIT"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0 0 0 10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Verschlüsselung"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                        <TextBlock Text="RSA-2048 + AES-256-CBC"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   Margin="0 3 0 0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Schlüsseldatei"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"/>
                        <TextBlock Text=".\data\private.key"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   Margin="0 3 0 0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- BUTTONS + STATUS -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource OnlineBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryBtn}"
                    Content="Speichern"
                    Command="{Binding SaveCommand}"
                    Width="130"
                    Height="40"/>
        </Grid>
    </Grid>
</Window>