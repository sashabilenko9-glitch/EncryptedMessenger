<UserControl x:Class="EncryptedMessenger.WPF.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BgMainBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <!-- ① Chat-Header       -->
            <RowDefinition Height="Auto"/>
            <!-- ①b Key-change banner (only while KeyChanged) -->
            <RowDefinition Height="*"/>
            <!-- ② Nachrichten-Liste -->
            <RowDefinition Height="Auto"/>
            <!-- ③ Lade-Indikator    -->
            <RowDefinition Height="Auto"/>
            <!-- ④ Eingabezeile      -->
        </Grid.RowDefinitions>

        <!-- ═══════════ ① CHAT-HEADER ═══════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BgHeaderBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0 0 0 1">
            <Grid Margin="14 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar + online dot -->
                <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                    <Border CornerRadius="21" Background="#2B4E6E">
                        <TextBlock Text="{Binding ContactFirstLetter}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse Width="12" Height="12"
                             Fill="{StaticResource OnlineBrush}"
                             Stroke="{StaticResource BgHeaderBrush}"
                             StrokeThickness="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Visibility="{Binding IsContactOnline, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Name + status -->
                <StackPanel Grid.Column="1" Margin="12 0 0 0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ContactName}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="15"/>
                        <Border Background="#1A3050"
                                CornerRadius="4"
                                Padding="6 2"
                                Margin="10 0 0 0"
                                VerticalAlignment="Center"
                                ToolTip="{Binding Fingerprint, StringFormat='Schlüssel-Fingerabdruck: {0}'}">
                            <TextBlock Text="🔒 Verschlüsselt"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="10"/>
                        </Border>
                        <Border Background="#5A1A1A"
                                CornerRadius="4"
                                Padding="6 2"
                                Margin="6 0 0 0"
                                VerticalAlignment="Center"
                                Visibility="{Binding KeyChanged, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding PendingFingerprint, StringFormat='Neuer Fingerabdruck: {0} — mit dem Kontakt vergleichen!'}">
                            <TextBlock Text="⚠ Schlüssel geändert"
                                       Foreground="#FF8080"
                                       FontSize="10"/>
                        </Border>
                        <!-- Verified: the user compared the 40-digit code with the contact -->
                        <Border Background="#163A22"
                                CornerRadius="4"
                                Padding="6 2"
                                Margin="6 0 0 0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding VerificationCode, StringFormat='Sicherheitscode {0} wurde mit dem Kontakt verglichen'}">
                            <TextBlock Text="✓ Überprüft"
                                       Foreground="{StaticResource OnlineBrush}"
                                       FontSize="10"/>
                        </Border>
                        <!-- Not verified yet: opens the compare dialog -->
                        <Button Style="{StaticResource IconBtn}"
                                Content="Code prüfen"
                                FontSize="10"
                                Padding="6 2"
                                Margin="6 0 0 0"
                                VerticalAlignment="Center"
                                Command="{Binding VerifyCommand}"
                                Visibility="{Binding CanVerify, Converter={StaticResource BoolToVis}}"
                                ToolTip="{Binding VerificationCode, StringFormat='Sicherheitscode: {0}'}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0 2 0 0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsContactOnline}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OnlineBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Right-side info + IP -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ContactIp}"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="AES-256-GCM"
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="10"
                               HorizontalAlignment="Right"
                               Margin="0 2 0 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ ①b KEY-CHANGE BANNER ═══════════ -->
        <!-- Shown while the peer presents a key other than the pinned one. The connection is
             refused and sending is disabled until the user compares the fingerprint and accepts. -->
        <Border Grid.Row="1"
                Background="#3A1818"
                BorderBrush="{StaticResource DangerBrush}"
                BorderThickness="0 0 0 1"
                Padding="16 10"
                Visibility="{Binding KeyChanged, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0 0 12 0">
                    <TextBlock Text="⚠ Schlüssel geändert – Verbindung blockiert"
                               Foreground="#FF8080"
                               FontWeight="SemiBold"
                               FontSize="13"/>
                    <TextBlock Text="Neu installiert oder Angriff? Vergleichen Sie diesen Fingerabdruck über Telefon oder persönlich:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0 3 0 4"/>
                    <!-- Read-only TextBox instead of TextBlock so the fingerprint can be selected/copied -->
                    <TextBox Text="{Binding PendingFingerprint, Mode=OneWay}"
                             IsReadOnly="True"
                             Style="{StaticResource PlainTextBox}"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource DangerBtn}"
                        Content="Neuen Schlüssel akzeptieren"
                        Command="{Binding AcceptKeyCommand}"
                        Padding="14 8"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════ ② NACHRICHTEN-LISTE ═══════════ -->
        <ScrollViewer Grid.Row="2"
                      x:Name="MessageScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{StaticResource BgMainBrush}"
                      Padding="0 8">

            <Grid>
                <!-- Loading spinner -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0 20 0 0"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="16"
                                   Margin="0 0 6 0"/>
                        <TextBlock Text="Lade Verlauf…"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Message items -->
                <ItemsControl ItemsSource="{Binding Messages}"
                              ItemTemplate="{StaticResource MessageBubble}"
                              Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"
                              Margin="0 8"/>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════ ③ SENDE-INDIKATOR ═══════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource BgMainBrush}"
                Padding="22 4 0 0"
                Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Senden…"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="11"
                       FontStyle="Italic"/>
        </Border>

        <!-- ═══════════ ④ EINGABEZEILE ═══════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource BgHeaderBrush}"
                BorderBrush="{StaticResource BorderLightBrush}"
                BorderThickness="0 1 0 0"
                Padding="14 10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- emoji btn -->
                    <ColumnDefinition Width="*"/>
                    <!-- text box  -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- send btn  -->
                </Grid.ColumnDefinitions>

                <!-- Emoji button + popup picker -->
                <Button Grid.Column="0"
                        x:Name="EmojiButton"
                        Style="{StaticResource IconBtn}"
                        Content="😊"
                        FontSize="19"
                        Padding="6"
                        Margin="0 0 6 0"
                        VerticalAlignment="Bottom"
                        Click="OnEmojiButtonClick"
                        ToolTip="Emoji einfügen"/>

                <Popup x:Name="EmojiPopup"
                       PlacementTarget="{Binding ElementName=EmojiButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade">
                    <Border Background="{StaticResource BgHeaderBrush}"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8"
                            Margin="4">
                        <ItemsControl ItemsSource="{Binding Emojis}" Width="260">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Command="{Binding DataContext.InsertEmojiCommand,
                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Click="OnEmojiPicked"
                                            Style="{StaticResource IconBtn}"
                                            FontSize="20"
                                            Width="38" Height="38"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>

                <!-- Text input -->
                <Border Grid.Column="1"
                        Background="{StaticResource BgInputBrush}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource BorderLightBrush}"
                        BorderThickness="1"
                        Padding="12 8">
                    <Grid>
                        <!-- Placeholder – sichtbar wenn DraftText leer -->
                        <TextBlock Text="Nachricht schreiben…"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsDraftEmpty, Converter={StaticResource BoolToVis}}"/>
                        <!-- Actual TextBox – styled by PlainTextBox (text remains visible) -->
                        <TextBox x:Name="MessageInput"
                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PlainTextBox}"
                                 FontSize="14"
                                 MinHeight="22"
                                 MaxHeight="100">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Send button -->
                <Button Grid.Column="2"
                        Style="{StaticResource PrimaryBtn}"
                        Command="{Binding SendCommand}"
                        Width="44" Height="44"
                        Padding="0"
                        Margin="8 0 0 0"
                        VerticalAlignment="Bottom"
                        ToolTip="Senden (Enter)">
                    <TextBlock Text="➤"
                               FontSize="18"
                               Foreground="White"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>