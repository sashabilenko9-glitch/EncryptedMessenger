<Window x:Class="EncryptedMessenger.WPF.Views.AddContactView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kontakt hinzufügen"
        Height="440" Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgMainBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="➕  Kontakt manuell hinzufügen"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"/>

        <Border Grid.Row="1"
                Background="{StaticResource BgHeaderBrush}"
                CornerRadius="8"
                Padding="12 10"
                Margin="0 14 0 18">
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="IP-Adresse des anderen PCs ermittelst du dort mit „ipconfig“ (IPv4-Adresse). Der Port ist der TCP-Port aus dessen Einstellungen (Standard 9876)."/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0 0 0 14">
            <TextBlock Text="Anzeigename (optional)"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0 0 0 5"/>
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="IP-Adresse"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0 0 0 5"/>
                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Port"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           Margin="0 0 0 5"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding Error}"
                   Foreground="{StaticResource DangerBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="CancelButton"
                    Content="Abbrechen"
                    Style="{StaticResource IconBtn}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Padding="16 10"
                    Margin="0 0 8 0"
                    Click="OnCancelClick"/>
            <Button x:Name="AddButton"
                    Content="Hinzufügen"
                    Style="{StaticResource PrimaryBtn}"
                    Width="130"
                    Height="40"
                    IsEnabled="{Binding IsValid}"
                    Click="OnAddClick"/>
        </StackPanel>
    </Grid>
</Window>