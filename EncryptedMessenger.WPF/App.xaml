<Application x:Class="EncryptedMessenger.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EncryptedMessenger.WPF.Converters"
             StartupUri="Views/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ═══ CONVERTER REGISTRY ═══ -->
            <conv:BoolToAlignmentConverter          x:Key="BoolToAlignment"/>
            <conv:BoolToBubbleColorConverter        x:Key="BoolToBubble"/>
            <conv:MessageStatusConverter            x:Key="StatusToGlyph"/>
            <conv:MessageStatusColorConverter       x:Key="StatusToColor"/>
            <conv:BoolToVisibilityConverter         x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter  x:Key="InvBoolToVis"/>
            <conv:NullToVisibilityConverter         x:Key="NullToVis"/>
            <conv:NullToInverseVisibilityConverter  x:Key="NullToInvVis"/>
            <conv:DateTimeToShortStringConverter    x:Key="DateToShort"/>

            <!-- ═══ DARK THEME PALETTE ═══ -->
            <SolidColorBrush x:Key="BgMainBrush"         Color="#17212B"/>
            <SolidColorBrush x:Key="BgHeaderBrush"       Color="#1F2D3D"/>
            <SolidColorBrush x:Key="BgSidebarBrush"      Color="#17212B"/>
            <SolidColorBrush x:Key="BgItemHoverBrush"    Color="#1F2D3D"/>
            <SolidColorBrush x:Key="BgItemSelectedBrush" Color="#2B5278"/>
            <SolidColorBrush x:Key="BgMsgInBrush"        Color="#182533"/>
            <SolidColorBrush x:Key="BgMsgOutBrush"       Color="#2B5278"/>
            <SolidColorBrush x:Key="BgInputBrush"        Color="#1C2E3E"/>
            <SolidColorBrush x:Key="BgSearchBrush"       Color="#1C2E3E"/>
            <SolidColorBrush x:Key="BorderLightBrush"    Color="#252E39"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#8B9BAD"/>
            <SolidColorBrush x:Key="TextMutedBrush"      Color="#4E6070"/>
            <SolidColorBrush x:Key="AccentBrush"         Color="#5AAAF7"/>
            <SolidColorBrush x:Key="AccentHoverBrush"    Color="#4090E0"/>
            <SolidColorBrush x:Key="OnlineBrush"         Color="#4DCD5E"/>
            <SolidColorBrush x:Key="OfflineBrush"        Color="#8B9BAD"/>
            <SolidColorBrush x:Key="DangerBrush"         Color="#FF4444"/>
            <SolidColorBrush x:Key="TransparentBrush"    Color="Transparent"/>
            <SolidColorBrush x:Key="ScrollBarBrush"      Color="#2B3E50"/>

            <!-- ═══ GLOBAL STYLES ═══ -->

            <!-- Window -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgMainBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <!-- Plain TextBox (no border/background, for use inside a custom Border) -->
            <Style x:Key="PlainTextBox" TargetType="TextBox">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush"      Value="{StaticResource AccentBrush}"/>
                <Setter Property="SelectionBrush"  Value="{StaticResource AccentBrush}"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScrollBar – slim, dark -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width"      Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid>
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{StaticResource ScrollBarBrush}"
                                                            CornerRadius="2" Margin="1"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TextBox (default, with border) -->
            <Style TargetType="TextBox">
                <Setter Property="Background"      Value="{StaticResource BgInputBrush}"/>
                <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderLightBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush"      Value="{StaticResource AccentBrush}"/>
                <Setter Property="SelectionBrush"  Value="{StaticResource AccentBrush}"/>
                <Setter Property="Padding"         Value="12 8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary button -->
            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="Background"      Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground"      Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="20 10"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Icon button (transparent, round hover) -->
            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="8"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A2A3A"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Danger button -->
            <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
                <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            </Style>

            <!-- ═══ MESSAGE BUBBLE DATATEMPLATE ═══ -->
            <DataTemplate x:Key="MessageBubble">
                <Grid Margin="12 2">
                    <Border Background="{Binding IsOutgoing, Converter={StaticResource BoolToBubble}}"
                            CornerRadius="14"
                            Padding="14 9"
                            MaxWidth="480"
                            HorizontalAlignment="{Binding IsOutgoing, Converter={StaticResource BoolToAlignment}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Text}"
                                       Foreground="White"
                                       FontSize="14"
                                       LineHeight="20"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="20 3 0 0">
                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateToShort}}"
                                           Foreground="#7FA8C8"
                                           FontSize="11"/>
                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToGlyph}}"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                           FontSize="11"
                                           Margin="5 0 0 0"
                                           Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>